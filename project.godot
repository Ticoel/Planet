; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Planet"
config/description="Une planète entièrement procédurale et autonome : tectonique, climat, eau, de l'orbite au sol."
config/version="1.0.0"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.04, 0.05, 0.07, 1)

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Planet"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
limits/global_shader_variables/buffer_size=1048576

[shader_globals]

planet_global_radius={
"type": "float",
"value": 6371000.0
}
